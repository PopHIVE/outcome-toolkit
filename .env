# NOTE:
#   Do not put any credentials/keys in this file!
#   See .env.secrets.template for more info.

# Tag
TAG=latest
DEPLOYMENT_ENV=local # (local|cicd|sandbox|dev|demo|prod)

# Local Registry
DOCKER_REGISTRY=outcome-toolkit

# Docker variables for networking
BACKEND_HOST=backend
BACKEND_PORT=5000
FRONTEND_HOST=frontend
FRONTEND_PORT=5001
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
NGINX_LISTEN_PORT=8080
NGINX_CORS_POLICY=localhost
API_HOST_URI=/api/

# Postgres Settings
POSTGRES_USER=postgres
POSTGRES_DB=postgres
DATASTORE_USER=dataminer
DATASTORE_DB=datawarehouse

# Data Bundle
DATA_BUNDLE=bundles/data_bundle_v0.32.0.zip

# PgAdmin Settings
PGADMIN_DEFAULT_EMAIL=outcome-toolkit-data@example.com

# Backend Config
REBUILD_DB=no
RUN_TESTS=no
SWAGGER_DOCS=yes
