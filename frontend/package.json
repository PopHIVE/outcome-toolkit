{
  "name": "outcome-toolkit-frontend",
  "type": "module",
  "version": "4.0",
  "private": true,
  "scripts": {
    "build-only": "vite build",
    "build": "npm run type-check && npm run build-only",
    "dev": "vite --port=5001 --host=0.0.0.0",
    "format": "prettier --write src/",
    "lint": "eslint . --ext .vue,.js,.ts --ignore-path .gitignore",
    "serve": "vite preview --port=5001 --host=0.0.0.0",
    "test:coverage": "vitest run --coverage",
    "test:setup": "playwright test --project setup",
    "test:e2e": "playwright test --project chromium --project firefox --project webkit",
    "test:interactive": "playwright test --ui . localhost",
    "test:quick": "playwright test --project quick",
    "test:unit": "vitest",
    "test:userguide": "playwright test --project userguide",
    "test:nav": "playwright test --project navigation",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.0.14",
    "@fontsource/public-sans": "^5.0.18",
    "@vueuse/core": "^13.5.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.2",
    "chartjs-plugin-annotation": "^3.0.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "pdfmake": "^0.2.10",
    "pinia": "^3.0.3",
    "runtypes": "^7.0.4",
    "vue": "^3.4.30",
    "vue-chartjs": "^5.3.1",
    "vue-error-boundary": "^2.0.3",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.49.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/bootstrap": "^5.2.10",
    "@types/leaflet": "^1.9.14",
    "@types/lodash": "^4.17.5",
    "@types/luxon": "^3.4.2",
    "@types/pdfmake": "^0.2.9",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/coverage-v8": "^3.1.3",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "dotenv": "^17.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^18.0.1",
    "leaflet": "^1.9.4",
    "playwright": "^1.49.1",
    "prettier": "^3.3.2",
    "sass-embedded": "^1.83.1",
    "typescript": "^5.5.2",
    "vite": "^7.0.5",
    "vite-plugin-dts": "^4.1.0",
    "vitest": "^3.1.3",
    "vue-tsc": "^3.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.6.1"
  }
}
