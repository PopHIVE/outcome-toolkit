# Source: https://github.com/docker/awesome-compose/tree/master/nginx-wsgi-flask/nginx


load_module /etc/nginx/modules/ndk_http_module.so;
load_module /etc/nginx/modules/ngx_http_set_misc_module.so;

worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 10000;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Define the format of log messages.
    log_format main_ext '$remote_addr - $remote_user [$time_local] "$request" '
    '$status $body_bytes_sent "$http_referer" '
    '"$http_user_agent" "$http_x_forwarded_for" '
    '"$host" sn="$server_name" '
    'rt=$request_time '
    'ua="$upstream_addr" us="$upstream_status" '
    'ut="$upstream_response_time" ul="$upstream_response_length" '
    'cs="$upstream_cache_status"' ;

    # Verbose Format
    log_format kv 'site="$server_name" server="$host" dest_port="$server_port" dest_ip="$server_addr" '
    'src="$remote_addr" src_ip="$realip_remote_addr" user="$remote_user" '
    'time_local="$time_local" protocol="$server_protocol" status="$status" '
    'bytes_out="$bytes_sent" bytes_in="$upstream_bytes_received" '
    'http_referer="$http_referer" http_user_agent="$http_user_agent" '
    'nginx_version="$nginx_version" http_x_forwarded_for="$http_x_forwarded_for" '
    'http_x_header="$http_x_header" uri_query="$query_string" uri_path="$uri" '
    'http_method="$request_method" response_time="$upstream_response_time" cs="$upstream_cache_status" '
    'cookie="$http_cookie" request_time="$request_time" category="$sent_http_content_type" https="$https"';

    access_log /var/log/nginx/access.log kv;
    error_log /var/log/nginx/error.log debug;

    sendfile on;

    # keepalive_timeout       100000;
    # proxy_connect_timeout   100000;
    # proxy_send_timeout      100000;
    # proxy_read_timeout      100000;
    # fastcgi_send_timeout    100000;
    # fastcgi_read_timeout    100000;

    # Enable Compression
    gzip on;

    # Disable Display of NGINX Version
    server_tokens off;

    # Size Limits
    client_body_buffer_size 2k;
    client_header_buffer_size 4k;
    client_max_body_size 2k;
    large_client_header_buffers 4 4k;

	

    # Cache control
    # TODO: cache control will need to be modified to private with introduction of user data
    # or divide public api routes from user data / confidential routes in config
    expires 24h;
    add_header Cache-Control "public";

    # # SSL / TLS Settings - Suggested for Security
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_session_timeout 15m;
    # ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    # ssl_prefer_server_ciphers on;
    # ssl_session_tickets off;

    # Set CORS Variable
    map "$http_origin" $cors {
        default $NGINX_CORS_POLICY;
        "~*$NGINX_CORS_POLICY" "$http_origin";
    }

    include /etc/nginx/conf.d/sites-enabled/$ROUTING_DIR/*.conf;

}
